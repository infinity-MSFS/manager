{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Infinity Manager Community",
  "mainBinaryName": "infinity-manager",
  "version": "4.0.0-alpha.0",
  "identifier": "com.infinity.manager.community",
  "build": {
    "beforeDevCommand": {
      "script": "cargo xtask frontend serve",
      "cwd": "../.."
    },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": {
      "script": "cargo xtask frontend build",
      "cwd": "../.."
    },
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Infinity Manager",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "decorations": false,
        "backgroundColor": "#000000",
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data: https:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "freezePrototype": true
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["infinity-manager-community"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/logo.png", "icons/infinity.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
